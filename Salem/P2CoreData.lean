/-- The fixed certified radius grid for the actual 2885-cell seed, padded by zero. -/
def p2CoreRadiusAt (i : ℕ) : ℚ :=
  if h : i < 2885 then p2GreenFastCoreRadius ⟨i, h⟩ else 0

/-- Few logarithm-series terms suffice on the small oscillatory bridge. -/
def p2CorePotentialTerms (i : ℕ) : ℕ :=
  if p2CoreRadiusAt i ≤ 1 / 10 then 0 else 6

/-- A nonnegative integer budget at the common denominator one million. -/
def p2CorePotentialTicks (i : ℕ) : ℕ :=
  ⌈rationalRadiusPotentialBound (p2CoreRadiusAt i) (p2CorePotentialTerms i) * 1000000⌉₊

/-- Eight-cell blocks keep the finite kernel calculations independent and small. -/
def p2CoreChunkTicks (k : ℕ) : ℕ :=
  ((List.range 8).map fun j => p2CorePotentialTicks (8 * k + j)).sum

